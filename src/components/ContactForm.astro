---
/**
 * ContactForm.astro
 * ─────────────────────────────────────────────────────────────
 * Formulario de contacto reutilizable vía Formspree.
 * Antes estaba duplicado (con variaciones) en:
 *   - index.astro (versión "Consulta Rápida" — 3 campos)
 *   - contacto.astro (versión completa — 5 campos con select de servicio)
 *
 * Uso versión compacta (home):
 *   <ContactForm variant="compact" />
 *
 * Uso versión completa (contacto):
 *   <ContactForm variant="full" />
 */

interface Props {
  variant?: 'compact' | 'full';
  formspreeId?: string;
}

const {
  variant = 'full',
  formspreeId = 'mdapkgog',
} = Astro.props;

const actionUrl = `https://formspree.io/f/${formspreeId}`;
---

<form
  class="contact-form"
  action={actionUrl}
  method="POST"
  id="contact-form"
  novalidate
>
  <!-- Antispam honeypot -->
  <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
  <input type="hidden" name="_subject" value="Nueva consulta desde inacons.com.pe" />

  <div class="form-row">
    <div class="form-group">
      <label for="cf-nombre">Nombre completo <span aria-hidden="true">*</span></label>
      <input
        type="text"
        id="cf-nombre"
        name="nombre"
        class="form-input"
        placeholder="Tu nombre"
        required
        autocomplete="name"
      />
    </div>
    <div class="form-group">
      <label for="cf-email">Correo electrónico <span aria-hidden="true">*</span></label>
      <input
        type="email"
        id="cf-email"
        name="email"
        class="form-input"
        placeholder="tu@correo.com"
        required
        autocomplete="email"
      />
    </div>
  </div>

  {variant === 'full' && (
    <div class="form-row">
      <div class="form-group">
        <label for="cf-phone">Teléfono *</label>
        <input
          type="tel"
          id="cf-phone"
          name="phone"
          class="form-input"
          placeholder="+51 000 000 000"
          required
          autocomplete="tel"
        />
      </div>
      <div class="form-group">
        <label for="cf-service">Servicio de interés *</label>
        <select id="cf-service" name="service" class="form-select" required>
          <option value="">Selecciona un servicio</option>
          <option value="obras-civiles">Obras Civiles</option>
          <option value="infraestructura">Infraestructura</option>
          <option value="electromecanica">Electromecánica</option>
          <option value="paisajismo">Paisajismo</option>
          <option value="mineria">Minería</option>
          <option value="consultoria">Consultoría</option>
          <option value="otro">Otro</option>
        </select>
      </div>
    </div>
  )}

  <div class="form-group">
    <label for="cf-mensaje">
      {variant === 'compact' ? '¿En qué podemos ayudarle?' : 'Mensaje'} <span aria-hidden="true">*</span>
    </label>
    <textarea
      id="cf-mensaje"
      name="mensaje"
      class="form-textarea"
      placeholder={variant === 'compact' ? '¿En qué podemos ayudarle?' : 'Describe tu proyecto o consulta...'}
      required
    ></textarea>
  </div>

  <!-- Estado: enviando / éxito / error -->
  <div class="form-feedback" id="cf-feedback" aria-live="polite" hidden></div>

  <button type="submit" class={variant === 'compact' ? 'btn btn-primary' : 'form-submit'} id="cf-submit">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
    {variant === 'compact' ? 'Enviar Consulta' : 'Enviar Mensaje'}
  </button>
</form>

<style>
  .form-group {
    margin-bottom: 14px;
  }

  .form-group label {
    display: block;
    font-size: 0.80rem;
    font-weight: 600;
    color: var(--c-text-heading);
    margin-bottom: 6px;
    letter-spacing: 0.2px;
  }

  .form-group label span {
    color: var(--c-secondary);
  }

  .form-feedback {
    padding: 12px 16px;
    border-radius: 4px;
    font-size: 0.88rem;
    font-weight: 500;
    margin-bottom: 12px;
  }

  .form-feedback.success {
    background: rgba(25, 135, 84, 0.08);
    border: 1px solid rgba(25, 135, 84, 0.25);
    color: #198754;
  }

  .form-feedback.error {
    background: rgba(220, 53, 69, 0.08);
    border: 1px solid rgba(220, 53, 69, 0.25);
    color: #dc3545;
  }
</style>

<!-- Submit handler — sin EmailJS, solo Formspree -->
<script>
  const form    = document.getElementById('contact-form') as HTMLFormElement | null;
  const submit  = document.getElementById('cf-submit') as HTMLButtonElement | null;
  const feedback = document.getElementById('cf-feedback') as HTMLElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submit || !feedback) return;

    submit.disabled = true;
    submit.textContent = 'Enviando…';

    try {
      const res = await fetch((form as HTMLFormElement).action, {
        method: 'POST',
        body: new FormData(form as HTMLFormElement),
        headers: { Accept: 'application/json' },
      });

      feedback.hidden = false;

      if (res.ok) {
        feedback.className = 'form-feedback success';
        feedback.textContent = '¡Mensaje enviado! Nos pondremos en contacto pronto.';
        (form as HTMLFormElement).reset();
        submit.textContent = 'Mensaje enviado ✓';
      } else {
        throw new Error('server error');
      }
    } catch {
      if (feedback) {
        feedback.hidden = false;
        feedback.className = 'form-feedback error';
        feedback.textContent = 'Error al enviar. Por favor escríbenos directamente a ventas@inacons.com.pe';
      }
      if (submit) {
        submit.disabled = false;
        submit.textContent = 'Reintentar';
      }
    }
  });
</script>
