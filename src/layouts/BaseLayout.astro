---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title,
  description,
  ogImage = '/assets/imagenes/image_heroprincipal.webp',
  canonical,
} = Astro.props;

const pageTitle       = title ?? 'INACONS';
const metaDescription = description ?? 'INACONS S.R.L. — Empresa peruana de ingeniería y construcción con más de 15 años de experiencia en obras civiles, infraestructura, electromecánica y más.';
const canonicalURL    = canonical ?? Astro.url.href;
const ogImageURL      = `https://inacons.com.pe${ogImage}`;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content="index, follow" />
    <title>{pageTitle} — INACONS</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content="INACONS" />
    <meta property="og:title"       content={`${pageTitle} — INACONS`} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image"       content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:locale"      content="es_PE" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={`${pageTitle} — INACONS`} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image"       content={ogImageURL} />

    <!--
      FONTS — preconnect primero, luego la hoja de estilos.
      font-display=swap evita el flash de texto invisible (FOIT).
      subset=latin reduce el peso descargado ~40%.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap&subset=latin"
      rel="stylesheet"
    />

    <!--
      Swiper CSS — cargado solo cuando existe el elemento que lo necesita.
      Se incluye aquí porque el <head> no tiene forma de saber qué página
      lo pide; el JS de Swiper se carga con defer desde cada página.
    -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
    />

    <!-- Design System INACONS -->
    <link rel="stylesheet" href="/assets/css/design-system.css" />

    <!-- Animaciones de scroll (reemplaza AOS — sin librería externa) -->
    <link rel="stylesheet" href="/assets/css/scroll-animations.css" />

    <slot name="head" />
  </head>

  <body>

    <!-- TOP BAR -->
    <div class="top-bar">
      <div class="container">
        <div class="top-bar-left">
          <div class="top-bar-contact">
            <!-- SVG inline: mail — reemplaza Font Awesome + Lucide -->
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span>ventas@inacons.com.pe</span>
          </div>
          <div class="top-bar-contact">
            <!-- SVG inline: phone -->
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.64 2.84h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.09a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>+51 064 654 736</span>
          </div>
          <a href="/canal-etico" class="top-bar-etico">Canal Ético</a>
        </div>
        <div class="top-bar-social">
          <a href="https://wa.me/51948888070" target="_blank" rel="noopener" aria-label="WhatsApp">
            <!-- SVG inline: WhatsApp -->
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
          </a>
          <a href="https://www.facebook.com/www.inacons.com.pe" target="_blank" rel="noopener" aria-label="Facebook">
            <!-- SVG inline: Facebook -->
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- HEADER -->
    <header class="header with-topbar" id="header">
      <div class="container">
        <a href="/" class="logo">
          <img src="/assets/imagenes/logos/logo_inacons_white.svg" alt="INACONS" class="logo-white" />
          <img src="/assets/imagenes/logos/logo_inacons.svg" alt="INACONS" class="logo-color" />
        </a>
        <nav class="nav">
          <ul>
            <li><a href="/nosotros">Nosotros</a></li>
            <li class="dropdown">
              <a href="/servicios">Operaciones</a>
              <ul class="dropdown-menu">
                <li><a href="/servicios/obras-civiles">Obras Civiles</a></li>
                <li><a href="/servicios/infraestructura">Infraestructura</a></li>
                <li><a href="/servicios/electromecanica">Electromecánica</a></li>
                <li><a href="/servicios/paisajismo">Paisajismo</a></li>
                <li><a href="/servicios/mineria">Minería</a></li>
                <li><a href="/servicios/consultoria">Consultoría</a></li>
              </ul>
            </li>
            <li><a href="/proyectos">Proyectos</a></li>
            <li><a href="/sostenibilidad">Sostenibilidad</a></li>
            <li><a href="/documentos">Documentos</a></li>
            <li>
              <a href="/contacto" class="nav-cta-btn">
                <!-- SVG inline: send -->
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                Contáctenos
              </a>
            </li>
          </ul>
        </nav>
        <button class="menu-toggle" id="menuToggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobileMenu">
          <!-- SVG inline: menu -->
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        </button>
      </div>
    </header>

    <!-- MENÚ MÓVIL -->
    <div class="mobile-menu" id="mobileMenu" role="dialog" aria-label="Menú de navegación">
      <div class="mobile-menu-overlay"></div>
      <div class="mobile-menu-content">
        <button class="mobile-menu-close" id="mobileMenuClose" aria-label="Cerrar menú">
          <!-- SVG inline: x -->
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
        <nav class="mobile-nav">
          <ul>
            <li><a href="/nosotros">Nosotros</a></li>
            <li><a href="/servicios">Operaciones</a></li>
            <li><a href="/proyectos">Proyectos</a></li>
            <li><a href="/sostenibilidad">Sostenibilidad</a></li>
            <li><a href="/documentos">Documentos</a></li>
            <li><a href="/canal-etico">Canal Ético</a></li>
            <li><a href="/contacto">Contacto</a></li>
          </ul>
        </nav>
      </div>
    </div>

    <!-- CONTENIDO -->
    <main class="main with-topbar">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="footer">
      <div class="container">
        <div class="footer-content">
          <div class="footer-section footer-brand">
            <div class="footer-logo">
              <img src="/assets/imagenes/logos/logo_inacons_white.svg" alt="INACONS" />
            </div>
            <p class="footer-slogan">
              CONSTRUIMOS CONFIANZA<br />
              INNOVAMOS ESPACIOS<br />
              TRASCENDEMOS JUNTOS
            </p>
            <div class="footer-social">
              <a href="https://wa.me/51948888070" target="_blank" rel="noopener" aria-label="WhatsApp">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
              </a>
              <a href="https://www.facebook.com/www.inacons.com.pe" target="_blank" rel="noopener" aria-label="Facebook">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
              <a href="https://pe.linkedin.com/company/inacons" target="_blank" rel="noopener" aria-label="LinkedIn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
            </div>
          </div>

          <div class="footer-section">
            <h3>Navegación</h3>
            <ul>
              <li><a href="/nosotros">Nosotros</a></li>
              <li><a href="/servicios">Operaciones</a></li>
              <li><a href="/proyectos">Proyectos</a></li>
              <li><a href="/sostenibilidad">Sostenibilidad</a></li>
              <li><a href="/documentos">Documentos</a></li>
              <li><a href="/canal-etico">Canal Ético</a></li>
            </ul>
          </div>

          <div class="footer-section">
            <h3>Servicios</h3>
            <ul>
              <li><a href="/servicios/obras-civiles">Obras Civiles</a></li>
              <li><a href="/servicios/infraestructura">Infraestructura</a></li>
              <li><a href="/servicios/electromecanica">Electromecánica</a></li>
              <li><a href="/servicios/paisajismo">Paisajismo</a></li>
              <li><a href="/servicios/mineria">Minería</a></li>
              <li><a href="/servicios/consultoria">Consultoría</a></li>
            </ul>
          </div>

          <div class="footer-section">
            <h3>Contacto</h3>
            <ul>
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.28)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:6px;" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                ventas@inacons.com.pe
              </li>
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.28)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:6px;" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.64 2.84h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.09a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                +51 064 654 736
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <div class="container">
          <p>&copy; {new Date().getFullYear()} INACONS S.R.L. — Todos los derechos reservados.</p>
          <div class="footer-bottom-links">
            <a href="/canal-etico">Canal Ético</a>
            <a href="/documentos">Documentos</a>
            <a href="/documentos">ISO 9001</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Botón volver arriba -->
    <button class="back-to-top" id="backToTop" aria-label="Volver arriba">
      <!-- SVG inline: chevron-up -->
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
    </button>

    <!--
      SCRIPTS
      ─────────────────────────────────────────────────────────────
      · defer: no bloquean el parser HTML. Se ejecutan al final.
      · type="module": ES modules, diferidos por defecto.
      · Swiper y main se cargan diferidos; el JS de página específica
        va en cada .astro con <script> (sin is:inline).
    -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
    <script src="/assets/js/main.js" defer></script>

  </body>
</html>
